{
  "name": "uwarp-mcp",
  "version": "1.0.0",
  "description": "MCP server for Uwarp — contrast check, palette generation, and local tool catalog search",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "uwarp-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/data && cp data/tools.json dist/data/tools.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/check_contrast.test.ts tests/generate_palette.test.ts tests/search_tools.test.ts",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "uwarp",
    "design",
    "contrast",
    "palette",
    "wcag"
  ],
  "author": "Sherotree <https://uwarp.design>",
  "license": "MIT",
  "homepage": "https://uwarp.design",
  "repository": {
    "type": "git",
    "url": "https://github.com/sherotree/uwarp-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
